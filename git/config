# Shared Git configuration for longkai/toolkits.
#
# Install: symlink this file to ~/.config/git/config (see README.md).
# Machine-local settings and secrets belong in ~/.gitconfig, which Git reads
# after this file and lets override it. Never commit credentials here.

[color]
  ui = true
[color "diff"]
  old = red strike
  new = green italic

[core]
  autocrlf = input

[init]
  defaultBranch = main

[filter "lfs"]
  process = git lfs filter-process
  clean = git lfs clean -- %f
  smudge = git lfs smudge -- %f
  required = true

[transfer]
  fsckObjects = true        # verify object integrity on fetch/push
[fetch]
  prune = true              # remove remote-tracking refs deleted upstream
[column]
  ui = auto
[branch]
  sort = -committerdate     # most recently used first
[tag]
  sort = version:refname
[log]
  date = iso
[commit]
  verbose = true            # show the diff in the commit editor

[diff]
  algorithm = histogram
  colorMoved = default      # highlight moved code
[merge]
  conflictStyle = zdiff3    # include the common ancestor in conflicts
[rerere]
  enabled = true            # reuse recorded conflict resolutions
[push]
  autoSetupRemote = true    # first push creates the upstream
[pull]
  rebase = true
[rebase]
  autoStash = true
  autosquash = true         # honor fixup!/squash! during interactive rebase

[alias]
  a = add
  b = branch
  c = commit
  d = diff
  s = status
  ch = checkout
  sw = switch
  rs = restore
  unstage = restore --staged
  last = log -1 HEAD --stat
  l = log --color --graph --max-count=20 --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
  sync = "!git fetch --prune origin && git rebase origin/main"
  gone = "!git for-each-ref --format='%(refname:short) %(worktreepath) %(upstream:track)' refs/heads | grep -F '[gone]' || true"
  stale = "!f() { d=${1:-30}; case $d in ''|*[!0-9]*|0?*) echo \"usage: git stale [days]\" >&2; exit 2 ;; esac; c=$(( $(date +%s) - d*86400 )); echo \"Branches with no commits in the last $d days:\"; git for-each-ref --sort=committerdate --format='%(committerdate:unix) %(committerdate:short) %(refname:short) %(worktreepath)' refs/heads | awk -v c=\"$c\" '$1 < c && $3 != \"main\" && $3 != \"master\" { sub(/^[^ ]+ /, \"\"); print \"  \" $0; n++ } END { if (!n) print \"  (none)\" }'; }; f"

[pager]
  diff = delta
  log = delta
  reflog = delta
  show = delta
[interactive]
  diffFilter = delta --color-only --features=interactive

[delta]
  features = line-numbers
  detect-dark-light = auto
  # Leave plus/minus styles unset: delta picks light/dark defaults.
