# =============================================================================
#  Ghostty 配置 —— 极客风 / 极致美观 / 高效 (macOS · Ghostty 1.4.0)
#  面向命令行内高频使用 Claude Code 的场景。
#
#  安装：软链到 ~/.config/ghostty/config（详见同目录 README_zh.md）
#  热重载：修改后在 Ghostty 中按 Cmd+Shift+, 即可重新加载，无需重启。
#  校验：/Applications/Ghostty.app/Contents/MacOS/ghostty +show-config
#  查文档：/Applications/Ghostty.app/Contents/MacOS/ghostty +explain-config（1.4 新增，分页显示）
# =============================================================================


# -----------------------------------------------------------------------------
#  主题与外观：随系统明暗模式自动切换（无需任何脚本）
# -----------------------------------------------------------------------------
# 浅色用 Catppuccin Latte，深色用 Catppuccin Mocha，二者均为 Ghostty 内置主题。
# theme = light:Catppuccin Latte,dark:Catppuccin Mocha
theme = Catppuccin Mocha

# 使用 Display-P3 广色域，让 mac 上的配色更鲜活通透。
window-colorspace = display-p3

# 让终端跟随主题自动决定窗口（标题栏等）明暗，观感统一。
window-theme = auto


# -----------------------------------------------------------------------------
#  默认 Shell：Nushell
# -----------------------------------------------------------------------------
# 新窗口/标签默认启动 nushell（绝对路径，避免 PATH 差异）。
# 若 nu 路径变化，用 `which nu` 重新确认后修改此处。
command = /opt/homebrew/bin/nu


# -----------------------------------------------------------------------------
#  字体与连字：Cascadia Code Nerd Font（连字 + Nerd Font 图标）
# -----------------------------------------------------------------------------
# 精确 family 名已用 `ghostty +list-fonts` 校验。自带 Nerd Font 图标，
# 供 starship / Claude Code 等 CLI 的图标正常显示。
font-family = Cascadia Code NF
# 中文回退：Cascadia Code NF 的 CJK 覆盖有限，显式指定中文字体作回退，
# 让中文标点/汉字的字重与基线更协调（font-family 可重复，首个为主字体，
# 其后按序作缺字回退）。若无 PingFang SC 可换 "Hiragino Sans GB" 等系统中文字体。
font-family = PingFang SC
font-size = 15

# 连字（Ligatures）：Cascadia Code 默认启用 calt/liga（如 -> == != >= 会合并渲染）。
# 这里显式声明以确保开启；如需关闭连字，把下面两行改为 -calt -liga 即可。
font-feature = calt
font-feature = liga

# 可选：启用 Cascadia 的手写体斜体（stylistic set 01）。喜欢花体注释可取消注释。
# font-feature = ss01

# mac 上略微加粗字形，提升小字号下的清晰度。
font-thicken = true

# 行高留白，长时间阅读日志/代码更舒适。
adjust-cell-height = 12%

# 可读性护栏：强制前景/背景至少 1.05 倍对比度，
# 避免个别配色/被程序染色的输出出现「暗字贴暗底」看不清的情况。
minimum-contrast = 1.05


# -----------------------------------------------------------------------------
#  毛玻璃与窗口：半透明 + 背景模糊，贴合 macOS 质感
#  （前后台窗口通过通透感自然区分 —— 间接实现"专注当前窗口"）
# -----------------------------------------------------------------------------
# 背景半透明：数值越小越透（1 = 不透明）。0.92 几乎看不出透，0.85 才有明显
# 毛玻璃感、且 Mocha 深底上文字依然清晰；想更透可试 0.8，再低可读性下降明显。
# 注意（macOS）：
#   - 改这个值必须 Cmd+Q 完全退出再打开，Cmd+Shift+, 热重载不生效；
#   - 原生全屏下会自动禁用透明；
#   - 「系统设置 → 辅助功能 → 显示 → 降低透明度」开启时也看不到透明效果。
background-opacity = 0.85

# 把透明度也应用到「显式设置了背景色」的单元格。默认只有窗口底色透明，
# Claude Code / nvim / tmux / htop 这类会整屏刷背景色的 TUI 会变成一块不透明的实底，
# 这正是「明明设了透明却不透」的常见原因。开启后整屏通透一致。
background-opacity-cells = true

# 背景模糊：直接用 macOS 原生「液态玻璃」（macOS 26+），而不是传统的高斯模糊半径。
#   macos-glass-clear   = 高度通透的玻璃（当前选择，最「透」）
#   macos-glass-regular = 带一定不透明度的标准玻璃，更磨砂
# 1.4 起玻璃层叠在背景色之上（透明度仍由上面的 background-opacity 控制），并修复了
# 「前台窗口反而比后台更不透明」的问题。
# 想回到传统模糊：改为数值，如 background-blur = 20（官方默认，再高可能渲染异常）。
background-blur = macos-glass-clear

# 文字的 alpha 混合色彩空间：linear-corrected 消除红/绿等配色下文字边缘发暗的
# 伪影，粗细观感与 native 基本一致（macOS 默认是 native）。
alpha-blending = linear-corrected

# 透明标题栏：内容与标题栏融为一体，配合毛玻璃更整体。
macos-titlebar-style = transparent

# 保留窗口投影，增强层次与"当前窗口"的存在感。
macos-window-shadow = true

# 舒适的内边距，让内容不贴边。
window-padding-x = 14
window-padding-y = 10
# 均衡分配内边距，视觉更居中。
# equal（1.4 新增）= 四边完全等距、不再限制顶部留白，比 true 更居中对称。
window-padding-balance = equal

# 极客风应用图标（Ghostty 新特性）。可选值如 official / xray / holographic /
# microchip / blueprint / chalkboard / glass / paper / retro。这里用 X 光风。
macos-icon = xray

# 缩放窗口/拖动分屏时显示的「列×行」尺寸浮层：默认在正中央，挡住内容；
# 挪到右下角，既能看到尺寸又不遮挡正在看的输出。
resize-overlay-position = bottom-right


# -----------------------------------------------------------------------------
#  Quick Terminal：全局热键在任意应用中呼出/隐藏（类 iTerm2 热键窗口）
#  注意：global: 前缀需在「系统设置 → 隐私与安全性 → 辅助功能」授予 Ghostty 权限。
# -----------------------------------------------------------------------------
keybind = global:opt+space=toggle_quick_terminal

# 从屏幕顶部下拉（Quake 风格）。
quick-terminal-position = top
# 呼出的显示器：main=主屏 / mouse=鼠标所在屏。
quick-terminal-screen = main
# 下拉/收起动画时长（秒）。
quick-terminal-animation-duration = 0.15
# 失去焦点时自动隐藏，用完即走。
quick-terminal-autohide = true


# -----------------------------------------------------------------------------
#  键位增强：命令面板 + 高频动作（Ghostty 新特性）
# -----------------------------------------------------------------------------
# 命令面板（VSCode 风格）：模糊搜索并执行任意 Ghostty 动作/自定义条目，
# 不用记快捷键。里面还能「把屏幕导出为 HTML/ANSI」「改标题」等。
keybind = cmd+shift+p=toggle_command_palette

# 一键把「当前屏幕 + 回滚历史」写入临时文件并用默认程序打开，
# 回看 Claude Code 的超长输出/报错时非常顺手。
keybind = cmd+shift+j=write_screen_file:open,plain

# 分屏效率：临时缩放当前分屏（专注）/ 均分所有分屏。
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits

# 命令间跳转：跳到上一条/下一条命令的提示符处（快速定位长输出里的每次执行）。
# 依赖 nushell 侧开启的 OSC 133 提示符标记（见 nushell/config.nu）。
# 1.4 起 macOS 默认的 Cmd+↑/↓ 也恢复为 jump_to_prompt（且可重绑），两套按键等价可用。
keybind = cmd+shift+up=jump_to_prompt:-1
keybind = cmd+shift+down=jump_to_prompt:1

# 毛玻璃 ⇄ 不透明 一键切换：看密集日志/截图分享时临时变实底，再按一次恢复通透。
# 1.4 起作用于整个窗口的所有标签，且新窗口继承当前状态（仅 macOS）。
# 若与默认键位冲突，用 `ghostty +list-keybinds --default` 查看后换键。
keybind = cmd+shift+o=toggle_background_opacity

# 1.4 新动作 move_tab_to_new_window（把当前标签拆成独立窗口）已内置在命令面板，
# Cmd+Shift+P 搜 "move tab" 即可，无需额外占用快捷键。


# -----------------------------------------------------------------------------
#  Emacs 风格命令行编辑：Option 作为 Meta 键
# -----------------------------------------------------------------------------
# 让 Option 作 Meta/Alt，从而 M-b 词左移、M-f 词右移、M-d 删词等生效
# （nushell 的 reedline 默认 emacs 键位，支持这些 Meta 组合键）。
#
# 取 true = 左右两个 Option 都作 Meta（最稳，"meta 键不生效"通常因只设了 left
# 却按了右 Option，或外接键盘布局差异）。
# 若你更希望保留「右 Option 输入特殊字符（重音/符号）」，把 true 改回 left，
# 并确保用「左」Option 触发 Meta。
macos-option-as-alt = true


# -----------------------------------------------------------------------------
#  分屏：失焦分屏调暗，突出当前活动分屏
#  （Ghostty 1.4 仍无"整窗失焦调暗"原生能力，此项仅作用于分屏；
#    整窗专注感由上面的透明+毛玻璃间接达成。）
#  取值 0~1：越小失焦分屏越暗、区分越强。深色主题（Mocha）下背景本就黑，
#  压暗天花板有限，需降狠些才明显。0.85 太亮看不出；0.75 仍偏弱；0.5 明确。
# -----------------------------------------------------------------------------
unfocused-split-opacity = 0.5


# -----------------------------------------------------------------------------
#  光标与鼠标
# -----------------------------------------------------------------------------
# 块状光标不闪烁，专注不分心。
cursor-style = block
cursor-style-blink = false
# 打字时自动隐藏鼠标指针，减少遮挡。
mouse-hide-while-typing = true


# -----------------------------------------------------------------------------
#  效率增强
# -----------------------------------------------------------------------------
# Shell 集成：detect 按启动的 shell 自动注入。1.4 起 Ghostty 的 ssh/sudo 包装在
# bash/zsh/fish/elvish/Nushell 下行为一致；同时本仓库在 nushell/config.nu 里开启了
# nu 内置的 shell_integration（OSC 2/7/8/133），标题、目录继承、超链接以及上面的
# jump_to_prompt「命令间跳转」均由它提供。
shell-integration = detect

# 功能开关（逗号分隔，no- 前缀表示关闭）：
#   cursor       提示符处光标形状
#   sudo         sudo 时保留 Ghostty 的 terminfo
#   title        由集成设置窗口标题
#   ssh-terminfo ssh 时自动把 Ghostty「自带」的 xterm-ghostty terminfo 装到远端：
#                Ghostty 升级后自动重装，本地无需 infocmp，按 host+port 缓存；
#                远端没有 tic 时自动退回 TERM=xterm-256color，不会把远端终端搞坏。
#                缓存管理：ghostty +ssh-cache [host[:port]] / --prune=30d
#   ssh-env      转发 COLORTERM / TERM_PROGRAM / TERM_PROGRAM_VERSION，
#                远端 vim/bat/delta 等能识别真彩色；1.4 起不再覆盖 ~/.ssh/config 的 SetEnv。
# 两个 ssh-* 在 1.4 改为统一调用 `ghostty +ssh`，取代了以往手动
# `infocmp -x ghostty | ssh <host> -- tic -x -` 的做法。
# 验证：在 nu 里 ssh 一台新机器后执行 `echo $TERM`，应为 xterm-ghostty（或无 tic 时为 xterm-256color）。
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# 命令跑完弹通知：fire 一个长任务后可切去别的窗口，跑完自动提醒（依赖上面
# OSC 133 提示符标记，本仓库 nushell/config.nu 已开启）。
#   unfocused = 仅当 Ghostty 窗口不在前台时才通知，不打扰当前操作。
# 搭配 -after 过滤掉短命令，只对耗时 ≥10s 的命令通知（回看 Claude Code 长任务超顺手）。
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s

# 关窗二次确认：防止 Cmd+W 误关正在跑 Claude Code 的窗口/分屏。
# Ghostty 只在「有进程正在运行」时才提示，纯 shell 提示符下直接关，不打扰。
confirm-close-surface = true

# 关闭「划词即复制」：选中不自动进剪贴板，需手动 Cmd+C 复制。
# 1.4 起取值改为 none/primary/clipboard/both，旧的 false 已废弃（等价 none）；
# macOS 默认也已是 none，这里显式写出以表明意图。
copy-on-select = none

# 复制时去掉每行行尾空白，粘贴代码/命令更干净。
clipboard-trim-trailing-spaces = true

# 滚动回溯：不再显式设置。1.4 默认上限已从 10MB 提到 50MB/终端，并对空闲回溯做压缩
# （省 70%~90% 物理内存）。旧的 scrollback-limit 已改名 scrollback-limit-bytes，
# 如需调整可用它，或用新的 scrollback-limit-lines 按行数限制（先到者生效）：
# scrollback-limit-bytes = 100000000
# scrollback-limit-lines = 200000

# 记住并恢复上次的窗口/会话状态。
window-save-state = always

# 新标签页继承当前工作目录与字号，体验连贯。
window-inherit-working-directory = true
window-inherit-font-size = true

# 有多个标签时才显示标签栏，界面更干净。
window-show-tab-bar = auto


# -----------------------------------------------------------------------------
#  可选项（默认关闭，按口味取消注释启用）
# -----------------------------------------------------------------------------
# 鼠标悬停即聚焦分屏（无需点击）。默认关闭，即「点击某分屏才聚焦它」。
# focus-follows-mouse = true

# 加快滚轮滚动速度（discrete 为普通鼠标滚轮的行数）。
# mouse-scroll-multiplier = precision:1,discrete:5

# URL 悬停预览（默认已开）；如觉得打扰可显式关闭。
# link-previews = false

# 背景贴图（酷但影响可读性）：图片路径 + 低不透明度 + 平铺方式。
# background-image = ~/Pictures/wallpaper.png
# background-image-opacity = 0.08
# background-image-fit = cover

# 标签页并入标题栏（Safari/Chrome 风格）：省一行纵向空间，界面更紧凑现代。
# 1.4 修复了该模式在 macOS 27 的布局，并支持中键关标签、双击标题缩放窗口。
# 与上面的 transparent 二选一（同一个 key）。
# macos-titlebar-style = tabs

# 窗口/标签标题字体：默认系统字体；想要极客风可改用等宽字体
# （1.4 修复了自定义字体导致标题被截断的问题）。
# window-title-font-family = Cascadia Code NF

# 中键行为（1.4 新增）：默认 primary-paste；本配置关了划词复制，primary 基本为空，
# 想让中键直接粘贴系统剪贴板可改为 clipboard-paste，怕误粘贴可设 ignore。
# middle-click-action = clipboard-paste

# 失焦分屏叠加填充色：不建议开启。它是「固定颜色」，不随 Latte/Mocha 明暗
# 主题切换，总会在其中一个主题下显得突兀（旧值 1a1b26 属 Tokyo Night，与本
# 配置的 Catppuccin 也不搭）。弱化失焦分屏用上面的 unfocused-split-opacity
# 即可，观感更自然。若坚持要用，请按主题挑同色系深色（Mocha 可用 181825）：
# unfocused-split-fill = 181825
